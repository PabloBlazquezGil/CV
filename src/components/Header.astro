---
// HEADER FIJO (un bloque por idioma).
// Oculto mientras se ve el vídeo; aparece al bajar con el nombre, el menú de
// secciones (solo escritorio) y el selector ES/GL. El script le pone data-scrolled.
import LangSwitch from "./LangSwitch.astro";
import { ui, type Lang } from "../data/web";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const sfx = lang === "es" ? "" : "-gl"; // los ids de ancla del bloque gallego llevan -gl
---

<div data-panel={lang} class="contents">
  <header
    data-header
    class="fixed top-0 left-0 right-0 z-40 bg-[#FAF8F5]/90 backdrop-blur-md border-b border-[#2C5E43]/10 shadow-sm transition-all duration-500 opacity-0 -translate-y-full pointer-events-none data-[scrolled]:opacity-100 data-[scrolled]:translate-y-0 data-[scrolled]:pointer-events-auto"
  >
    <div class="max-w-6xl mx-auto px-4 md:px-12 py-3 flex items-center justify-between gap-4">
      <a href="#hero" class="text-sm md:text-base font-bold tracking-[0.25em] uppercase text-[#2C5E43]">
        Pablo Blázquez Gil
      </a>
      <nav class="flex items-center gap-6">
        <ul class="hidden md:flex items-center gap-6 text-sm text-[#53645A]">
          <li><a href={`#about${sfx}`} class="hover:text-[#2C5E43] transition-colors">{t.nav.about}</a></li>
          <li><a href={`#experience${sfx}`} class="hover:text-[#2C5E43] transition-colors">{t.nav.experience}</a></li>
          <li><a href={`#portfolio${sfx}`} class="hover:text-[#2C5E43] transition-colors">{t.nav.projects}</a></li>
          <li><a href={`#contact${sfx}`} class="hover:text-[#2C5E43] transition-colors">{t.nav.contact}</a></li>
        </ul>
        <LangSwitch label={t.langLabel} />
      </nav>
    </div>
  </header>
</div>
