---
// CONTENIDO DE LA PÁGINA EN UN IDIOMA (perfil, experiencia, proyectos,
// formación, contacto y pie). index.astro lo pinta dos veces (es y gl) y el CSS
// enseña solo el del idioma activo. Todo el texto sale de src/data/.
import {
  Download, ChevronDown, Mail, MapPin, CalendarCheck, GraduationCap, Award,
  Languages, Clapperboard, ExternalLink, Play, ChevronsUpDown,
} from "@lucide/astro";
import LangSwitch from "./LangSwitch.astro";
import { cv, ui, links, galleryItems, type Lang } from "../data/web";

interface Props { lang: Lang; year: number }
const { lang, year } = Astro.props;
const t = ui[lang];
const d = cv[lang];
// Cada idioma tiene su propio bloque, así que los ids de ancla se distinguen.
const anchor = (name: string) => (lang === "es" ? name : `${name}-gl`);

// Experiencia en el orden definido en el JSON del CV.
const experience = d.orden.map((id) => d.experiencia[id as keyof typeof d.experiencia]);

// Clases comunes de cada sección: título a la izquierda, contenido a la derecha,
// y una línea gruesa arriba que marca dónde empieza.
const sectionClass = "grid grid-cols-1 md:grid-cols-12 gap-x-10 gap-y-5 border-t-2 border-[#14241E] pt-5";

const socials = [
  { href: links.linkedin, label: "LinkedIn" },
  { href: links.instagram, label: "Instagram" },
  { href: links.portfolio, label: "Portfolio" },
];
---

<div data-panel={lang} class="contents">
  <main class="w-full max-w-5xl mx-auto px-6 md:px-12 py-12 md:py-16 space-y-14 md:space-y-20">
    <!-- SECCIÓN 2: PRESENTACIÓN Y PERFIL
         Foto a la izquierda; nombre, titular, disponibilidad, botones, perfil
         y competencias clave a la derecha. -->
    <section id={anchor("about")} class="scroll-mt-24">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="md:col-span-4 flex md:block justify-center">
          <div class="relative w-40 sm:w-48 md:w-full aspect-[3/4] rounded-md overflow-hidden">
            <img
              src="https://archivos.thundershoot.com/2025/03/Pablo-Equipo-1-scaled.jpg"
              alt="Pablo Blázquez Gil"
              sizes="(max-width: 768px) 192px, 320px"
              class="absolute inset-0 w-full h-full object-cover object-top"
              fetchpriority={lang === "es" ? "high" : "low"}
              decoding="async"
              referrerpolicy="no-referrer"
            />
          </div>
        </div>

        <div class="md:col-span-8 space-y-5">
          <div class="flex items-start justify-between gap-4">
            <p class="text-sm font-medium text-[#1F5A45]">{t.heroKicker}</p>
            <LangSwitch label={t.langLabel} />
          </div>
          <div class="space-y-2">
            <h1 class="text-4xl md:text-6xl font-extrabold text-[#14241E] leading-[1.02]">{d.nombre}</h1>
            <p class="text-lg md:text-xl text-[#1A4535]">{d.titular}</p>
          </div>
          <ul class="space-y-1.5 text-sm text-[#4B5E55]">
            <li class="flex items-start gap-2"><MapPin class="w-4 h-4 shrink-0 mt-0.5 text-[#1F5A45]" aria-hidden="true" />{t.location}</li>
            <li class="flex items-start gap-2"><CalendarCheck class="w-4 h-4 shrink-0 mt-0.5 text-[#1F5A45]" aria-hidden="true" />{d.disponibilidad}</li>
          </ul>
          <div class="flex flex-wrap gap-3">
            <a
              href={links.cvPdf[lang]}
              download
              class="inline-flex items-center gap-2 px-5 py-3 bg-[#1F5A45] hover:bg-[#143D2F] text-white font-medium rounded-lg text-sm transition-colors duration-300"
            >
              <Download class="w-4 h-4" aria-hidden="true" />{t.downloadCv}
            </a>
            <a
              href={`mailto:${links.email}`}
              class="inline-flex items-center gap-2 px-5 py-3 border border-[#1F5A45]/40 text-[#1F5A45] hover:bg-[#1F5A45]/5 font-medium rounded-lg text-sm transition-colors duration-300"
            >
              <Mail class="w-4 h-4" aria-hidden="true" />{t.contactCta}
            </a>
          </div>
          <p class="text-[#2F4239] text-base md:text-[1.05rem] leading-relaxed max-w-[62ch]">{d.perfil}</p>
          <blockquote class="border-l-[3px] border-[#E0A526] pl-4 text-[#1A4535] text-base font-display leading-snug max-w-[56ch]">
            “{t.quote}”
          </blockquote>
          <ul class="flex flex-wrap gap-2" aria-label={d.etiquetas.clave}>
            {d.clave.map((skill) => (
              <li class="px-3 py-1.5 bg-[#DCE6DF] rounded-md text-xs font-medium text-[#1A4535]">{skill}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 3: EXPERIENCIA
         Lista compacta: cada puesto muestra cargo, entidad y fechas, y se
         despliega al pulsar para ver el detalle. El primero sale abierto. -->
    <section id={anchor("experience")} class={`${sectionClass} scroll-mt-24`}>
      <div class="md:col-span-3 space-y-3">
        <h2 class="text-2xl md:text-3xl font-bold text-[#14241E]">{d.etiquetas.experiencia}</h2>
        <button
          type="button"
          data-expand-all
          data-label-expand={t.expandAll}
          data-label-collapse={t.collapseAll}
          class="inline-flex items-center gap-2 min-h-10 text-sm font-medium text-[#1F5A45] hover:underline underline-offset-4"
        >
          <ChevronsUpDown class="w-4 h-4" aria-hidden="true" /><span>{t.expandAll}</span>
        </button>
      </div>
      <ul class="md:col-span-9 divide-y divide-[#D3DED7] border-b border-[#D3DED7]">
        {experience.map((job, i) => (
          <li>
            <details class="group py-4" data-job open={i === 0}>
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div>
                  <h3 class="text-base font-semibold text-[#14241E] group-hover:text-[#1F5A45] transition-colors">{job.cargo}</h3>
                  <p class="text-sm text-[#4B5E55]">{job.entidad} · {job.lugar}</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-xs font-medium text-[#1F5A45] whitespace-nowrap">{job.fechas}</span>
                  <ChevronDown class="w-4 h-4 text-[#1F5A45] transition-transform group-open:rotate-180" aria-hidden="true" />
                </div>
              </summary>
              <ul class="mt-3 space-y-1.5 text-sm text-[#3A4D44] leading-relaxed list-disc pl-5 marker:text-[#1F5A45]/60">
                {job.puntos.map((p) => <li>{p}</li>)}
              </ul>
            </details>
          </li>
        ))}
      </ul>
    </section>

    <!-- SECCIÓN 4: PROYECTOS
         Tarjetas a partir de galleryItems (src/data/web.ts). Al hacer clic en un
         vídeo se abre el visor; los proyectos "soon" se muestran sin vídeo. -->
    <section id={anchor("portfolio")} class={`${sectionClass} scroll-mt-24`}>
      <div class="md:col-span-3 space-y-3">
        <h2 class="text-2xl md:text-3xl font-bold text-[#14241E]">{t.projectsTitle}</h2>
        <a
          href={links.portfolio}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 min-h-10 text-sm font-medium text-[#1F5A45] hover:underline underline-offset-4"
        >
          {t.fullPortfolio}<ExternalLink class="w-4 h-4 shrink-0" aria-hidden="true" />
        </a>
      </div>

      <div class="md:col-span-9 grid grid-cols-2 gap-x-4 gap-y-8">
        {galleryItems.map((item, index) => {
          const isVideo = item.type === "video";
          // El primer proyecto ocupa todo el ancho: es el que más pesa.
          const wide = index === 0;
          const cardClass = `group text-left flex flex-col gap-3 ${wide ? "col-span-2" : ""}`;
          const body = (
            <>
              <div class={`relative overflow-hidden rounded-md bg-[#14241E] ${wide ? "aspect-[16/9] md:aspect-[2/1]" : "aspect-video"}`}>
                {isVideo ? (
                  <>
                    {/* #t=0.5 hace que el navegador muestre un fotograma real como miniatura. */}
                    <video
                      src={`${item.src}#t=0.5`}
                      muted
                      playsinline
                      preload="metadata"
                      referrerpolicy="no-referrer"
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-[#14241E]/60 via-transparent to-transparent"></div>
                    <span class={`absolute left-3 bottom-3 rounded-full bg-[#E0A526] text-[#14241E] flex items-center justify-center shadow-md transition-transform group-hover:scale-110 ${wide ? "w-14 h-14" : "w-10 h-10"}`}>
                      <Play class={`fill-[#14241E] ml-0.5 ${wide ? "w-5 h-5" : "w-4 h-4"}`} aria-hidden="true" />
                    </span>
                  </>
                ) : (
                  <div class="w-full h-full flex flex-col items-start justify-end gap-2 p-4 text-white/85 bg-[#1F5A45]">
                    <Clapperboard class="w-7 h-7" aria-hidden="true" />
                    <span class="text-sm font-medium">{t.inProgress}</span>
                  </div>
                )}
              </div>
              <div class="space-y-1">
                <h3 class={`font-display font-semibold text-[#14241E] group-hover:text-[#1F5A45] transition-colors leading-snug ${wide ? "text-xl md:text-2xl" : "text-base md:text-lg"}`}>
                  {item.title[lang]}
                </h3>
                <p class="text-sm font-medium text-[#1F5A45]">{item.category[lang]}</p>
                <p class="hidden sm:block text-sm text-[#4B5E55] leading-relaxed line-clamp-2 max-w-[62ch]">{item.desc[lang]}</p>
              </div>
            </>
          );
          return isVideo ? (
            <button
              type="button"
              data-gallery={index}
              aria-label={`${t.playVideo}: ${item.title[lang]}`}
              class={`${cardClass} cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#1F5A45]`}
            >
              {body}
            </button>
          ) : (
            <div class={cardClass}>{body}</div>
          );
        })}
      </div>
    </section>

    <!-- SECCIÓN 5: FORMACIÓN, PREMIOS, IDIOMAS Y OTROS DATOS
         Tres columnas compactas. Las competencias técnicas y los cursos van
         plegados (están completos en el PDF). -->
    <section class={sectionClass}>
      <div class="md:col-span-3">
        <h2 class="text-2xl md:text-3xl font-bold text-[#14241E]">{t.educationKicker}</h2>
      </div>
      <div class="md:col-span-9 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-8">
        <div class="space-y-3">
          <h3 class="flex items-center gap-2 text-base font-display font-semibold text-[#14241E]">
            <GraduationCap class="w-4 h-4" aria-hidden="true" />{d.etiquetas.formacion}
          </h3>
          <ul class="space-y-3 text-sm">
            {d.formacion.map((f) => (
              <li>
                <p class="font-medium text-[#14241E]">{f.titulo}</p>
                <p class="text-[#4B5E55]">{f.entidad} · {f.fechas}</p>
                {"nota" in f && f.nota && <p class="text-[#1F5A45]">{f.nota}</p>}
              </li>
            ))}
          </ul>
        </div>
        <div class="space-y-3">
          <h3 class="flex items-center gap-2 text-base font-display font-semibold text-[#14241E]">
            <Award class="w-4 h-4" aria-hidden="true" />{d.etiquetas.premios}
          </h3>
          <ul class="space-y-2 text-sm text-[#4B5E55] leading-snug list-disc pl-4 marker:text-[#1F5A45]/60">
            {d.premios.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="space-y-3">
          <h3 class="flex items-center gap-2 text-base font-display font-semibold text-[#14241E]">
            <Languages class="w-4 h-4" aria-hidden="true" />{d.etiquetas.idiomas}
          </h3>
          <ul class="space-y-1.5 text-sm text-[#4B5E55] leading-snug">
            {d.idiomas.map((i) => <li>{i}</li>)}
            {d.otros.map((o) => <li>{o}</li>)}
          </ul>
        </div>
      </div>

      <details class="group border-y border-[#D3DED7] py-1">
        <summary class="flex items-center justify-between gap-4 py-2 min-h-11 cursor-pointer list-none text-sm font-medium text-[#1F5A45] [&::-webkit-details-marker]:hidden">
          {t.moreSkills}
          <ChevronDown class="w-4 h-4 transition-transform group-open:rotate-180" aria-hidden="true" />
        </summary>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 text-sm">
          {d.competencias.map((c) => (
            <p class="text-[#4B5E55] font-light">
              <strong class="font-semibold text-[#1A4535]">{c.grupo}:</strong> {c.items}
            </p>
          ))}
        </div>
        <h3 class="mt-5 text-base font-display font-semibold text-[#14241E]">{d.etiquetas.cursos}</h3>
        <ul class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-1.5 text-sm text-[#4B5E55] font-light list-disc pl-4 marker:text-[#1F5A45]/60">
          {d.cursos.map((c) => <li>{c}</li>)}
        </ul>
      </details>
      </div>
    </section>

    <!-- SECCIÓN 6: CONTACTO -->
    <section id={anchor("contact")} class="scroll-mt-24 pb-4 md:pb-0">
      <div class="border-t-2 border-[#14241E] pt-8 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-center">
        <div class="md:col-span-7 space-y-3">
          <h2 class="text-3xl md:text-4xl font-extrabold text-[#14241E]">{t.contactTitle}</h2>
          <p class="text-[#2F4239] text-base max-w-[56ch]">{t.contactText}</p>
          <a href={`mailto:${links.email}`} class="inline-block py-2 text-[#1F5A45] font-medium hover:underline underline-offset-4">
            {links.email}
          </a>
        </div>
        <div class="md:col-span-5 flex flex-col md:items-end gap-4">
          <div class="flex flex-wrap gap-3">
            <a
              href={`mailto:${links.email}`}
              class="w-12 h-12 inline-flex items-center justify-center bg-[#1F5A45] text-white hover:bg-[#143D2F] rounded-lg transition-all duration-300 hover:scale-105"
              aria-label="Email"
              title="Email"
            >
              <Mail class="w-5 h-5" />
            </a>
            {socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 inline-flex items-center justify-center bg-white border border-[#D3DED7] hover:border-[#1F5A45]/40 text-[#4B5E55] hover:text-[#1F5A45] rounded-lg transition-all duration-300 hover:scale-105"
                aria-label={s.label}
                title={s.label}
              >
                {s.label === "LinkedIn" && (
                  // Lucide no incluye logotipos de marcas, así que van como SVG propios.
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                  </svg>
                )}
                {s.label === "Instagram" && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {s.label === "Portfolio" && <ExternalLink class="w-5 h-5" />}
              </a>
            ))}
          </div>
          <a
            href={links.cvPdf[lang]}
            download
            class="inline-flex items-center gap-2 px-5 py-3 bg-white border border-[#C5D4CA] text-[#1F5A45] hover:border-[#1F5A45]/50 font-medium rounded-lg text-sm transition-colors"
          >
            <Download class="w-4 h-4" aria-hidden="true" />{t.downloadCv}
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="w-full py-8 border-t border-[#D3DED7] text-center text-xs text-[#4B5E55] font-light bg-[#E6EBE6]/30 mt-auto pb-24 md:pb-8">
    <div class="max-w-5xl mx-auto px-6">
      <p>&copy; <span data-year>{year}</span> Pablo Blázquez Gil. {t.footer}</p>
    </div>
  </footer>
</div>
