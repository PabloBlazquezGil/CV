---
// CONTENIDO DE LA PÁGINA EN UN IDIOMA (perfil, experiencia, proyectos,
// formación, contacto y pie). index.astro lo pinta dos veces (es y gl) y el CSS
// enseña solo el del idioma activo. Todo el texto sale de src/data/.
import {
  Download, ChevronDown, Mail, MapPin, CalendarCheck, GraduationCap, Award,
  Languages, Clapperboard, ExternalLink, Play,
} from "@lucide/astro";
import Kicker from "./Kicker.astro";
import LangSwitch from "./LangSwitch.astro";
import { cv, ui, links, galleryItems, type Lang } from "../data/web";

interface Props { lang: Lang; year: number }
const { lang, year } = Astro.props;
const t = ui[lang];
const d = cv[lang];
// Cada idioma tiene su propio bloque, así que los ids de ancla se distinguen.
const anchor = (name: string) => (lang === "es" ? name : `${name}-gl`);

// Experiencia en el orden definido en el JSON del CV.
const experience = d.orden.map((id) => d.experiencia[id as keyof typeof d.experiencia]);

const socials = [
  { href: links.linkedin, label: "LinkedIn" },
  { href: links.instagram, label: "Instagram" },
  { href: links.portfolio, label: "Portfolio" },
];
---

<div data-panel={lang} class="contents">
  <main class="w-full max-w-5xl mx-auto px-6 md:px-12 py-12 md:py-16 space-y-16 md:space-y-24">
    <!-- SECCIÓN 2: PRESENTACIÓN Y PERFIL
         Foto a la izquierda; nombre, titular, disponibilidad, botones, perfil
         y competencias clave a la derecha. -->
    <section id={anchor("about")} class="scroll-mt-24">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="md:col-span-4 flex md:block justify-center">
          <div class="relative w-40 sm:w-48 md:w-full aspect-[3/4] rounded-2xl overflow-hidden border border-[#2C5E43]/10 shadow-lg">
            <img
              src="https://thundershoot.com/wp-content/uploads/2025/03/Pablo-Equipo-1-scaled.jpg"
              alt="Pablo Blázquez Gil"
              sizes="(max-width: 768px) 192px, 320px"
              class="absolute inset-0 w-full h-full object-cover object-top"
              fetchpriority={lang === "es" ? "high" : "low"}
              decoding="async"
            />
          </div>
        </div>

        <div class="md:col-span-8 space-y-5">
          <div class="flex items-start justify-between gap-4">
            <p class="text-xs uppercase tracking-[0.2em] font-semibold text-[#2C5E43]">{t.heroKicker}</p>
            <LangSwitch label={t.langLabel} />
          </div>
          <div class="space-y-2">
            <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-[#1E2D24] leading-[1.05]">{d.nombre}</h1>
            <p class="text-lg md:text-xl font-light text-[#284B37]">{d.titular}</p>
          </div>
          <ul class="space-y-1.5 text-sm text-[#53645A]">
            <li class="flex items-start gap-2"><MapPin class="w-4 h-4 shrink-0 mt-0.5 text-[#2C5E43]" aria-hidden="true" />{t.location}</li>
            <li class="flex items-start gap-2"><CalendarCheck class="w-4 h-4 shrink-0 mt-0.5 text-[#2C5E43]" aria-hidden="true" />{d.disponibilidad}</li>
          </ul>
          <div class="flex flex-wrap gap-3">
            <a
              href={links.cvPdf[lang]}
              download
              class="glow-effect inline-flex items-center gap-2 px-5 py-3 bg-[#2C5E43] hover:bg-[#1F4430] text-white font-medium rounded-xl text-sm transition-colors duration-300 shadow-md"
            >
              <Download class="w-4 h-4" aria-hidden="true" />{t.downloadCv}
            </a>
            <a
              href={`mailto:${links.email}`}
              class="inline-flex items-center gap-2 px-5 py-3 bg-white border border-[#D5E5DA] text-[#2C5E43] hover:border-[#2C5E43]/50 font-medium rounded-xl text-sm transition-colors duration-300"
            >
              <Mail class="w-4 h-4" aria-hidden="true" />{t.contactCta}
            </a>
          </div>
          <p class="text-[#53645A] text-sm md:text-base font-light leading-relaxed">{d.perfil}</p>
          <blockquote class="border-l-2 border-[#2C5E43] pl-4 italic text-[#284B37] text-sm">
            “{t.quote}”
          </blockquote>
          <ul class="flex flex-wrap gap-2" aria-label={d.etiquetas.clave}>
            {d.clave.map((skill) => (
              <li class="px-3 py-1.5 bg-[#F4F8F5] border border-[#D5E5DA] rounded-lg text-xs text-[#284B37]">{skill}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- SECCIÓN 3: EXPERIENCIA
         Lista compacta: cada puesto muestra cargo, entidad y fechas, y se
         despliega al pulsar para ver el detalle. El primero sale abierto. -->
    <section id={anchor("experience")} class="reveal-entry space-y-6 scroll-mt-24">
      <div class="space-y-2">
        <Kicker>{t.experienceKicker}</Kicker>
        <h2 class="text-2xl md:text-3xl font-semibold text-[#1E2D24]">{d.etiquetas.experiencia}</h2>
      </div>
      <ul class="divide-y divide-[#E2ECE5] border-y border-[#E2ECE5]">
        {experience.map((job, i) => (
          <li>
            <details class="group py-4" open={i === 0}>
              <summary class="flex items-start justify-between gap-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                <div>
                  <h3 class="text-base font-semibold text-[#1E2D24] group-hover:text-[#2C5E43] transition-colors">{job.cargo}</h3>
                  <p class="text-sm text-[#53645A]">{job.entidad} · {job.lugar}</p>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <span class="text-xs font-medium text-[#2C5E43] whitespace-nowrap">{job.fechas}</span>
                  <ChevronDown class="w-4 h-4 text-[#2C5E43] transition-transform group-open:rotate-180" aria-hidden="true" />
                </div>
              </summary>
              <ul class="mt-3 space-y-1.5 text-sm text-[#53645A] font-light leading-relaxed list-disc pl-5 marker:text-[#2C5E43]/60">
                {job.puntos.map((p) => <li>{p}</li>)}
              </ul>
            </details>
          </li>
        ))}
      </ul>
    </section>

    <!-- SECCIÓN 4: PROYECTOS
         Tarjetas a partir de galleryItems (src/data/web.ts). Al hacer clic en un
         vídeo se abre el visor; los proyectos "soon" se muestran sin vídeo. -->
    <section id={anchor("portfolio")} class="reveal-entry space-y-6 scroll-mt-24">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
        <div class="space-y-2">
          <Kicker>{t.projectsKicker}</Kicker>
          <h2 class="text-2xl md:text-3xl font-semibold text-[#1E2D24]">{t.projectsTitle}</h2>
        </div>
        <a
          href={links.portfolio}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 py-2 text-sm font-medium text-[#2C5E43] hover:text-[#1F4430] underline-offset-4 hover:underline"
        >
          {t.fullPortfolio}<ExternalLink class="w-4 h-4" aria-hidden="true" />
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
        {galleryItems.map((item, index) => {
          const isVideo = item.type === "video";
          const cardClass =
            "group text-left bg-white border border-[#E2ECE5] rounded-2xl overflow-hidden transition-all duration-500 shadow-sm flex flex-col";
          const body = (
            <>
              <div class="relative aspect-video overflow-hidden bg-[#1E2D24]">
                {isVideo ? (
                  <>
                    <video
                      src={item.src}
                      muted
                      playsinline
                      preload="metadata"
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                    <div class="absolute inset-0 flex items-center justify-center">
                      <span class="w-10 h-10 rounded-full bg-[#1E2D24]/80 backdrop-blur-sm border border-white/20 flex items-center justify-center text-white shadow-md group-hover:scale-110 transition-transform">
                        <Play class="w-4 h-4 fill-white ml-0.5" aria-hidden="true" />
                      </span>
                    </div>
                  </>
                ) : (
                  <div class="w-full h-full flex flex-col items-center justify-center gap-2 text-white/80 bg-gradient-to-br from-[#2C5E43] to-[#1E2D24]">
                    <Clapperboard class="w-7 h-7" aria-hidden="true" />
                    <span class="text-xs uppercase tracking-[0.2em]">{t.inProgress}</span>
                  </div>
                )}
              </div>
              <div class="p-4 space-y-1">
                <span class="text-xs text-[#2C5E43] font-semibold uppercase tracking-wider">{item.category[lang]}</span>
                <h3 class="text-sm md:text-base font-medium text-[#1E2D24] group-hover:text-[#2C5E43] transition-colors duration-300">
                  {item.title[lang]}
                </h3>
              </div>
            </>
          );
          return isVideo ? (
            <button
              type="button"
              data-gallery={index}
              aria-label={`${t.playVideo}: ${item.title[lang]}`}
              class={`${cardClass} cursor-pointer hover:border-[#2C5E43]/40 hover:shadow-md focus-visible:outline-2 focus-visible:outline-[#2C5E43]`}
            >
              {body}
            </button>
          ) : (
            <div class={cardClass} title={item.desc[lang]}>{body}</div>
          );
        })}
      </div>
    </section>

    <!-- SECCIÓN 5: FORMACIÓN, PREMIOS, IDIOMAS Y OTROS DATOS
         Tres columnas compactas. Las competencias técnicas y los cursos van
         plegados (están completos en el PDF). -->
    <section class="reveal-entry space-y-6">
      <div class="space-y-2">
        <Kicker>{t.educationKicker}</Kicker>
        <h2 class="text-2xl md:text-3xl font-semibold text-[#1E2D24]">{d.etiquetas.formacion}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-white border border-[#E2ECE5] rounded-2xl p-5 space-y-3 shadow-sm">
          <h3 class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#2C5E43]">
            <GraduationCap class="w-4 h-4" aria-hidden="true" />{d.etiquetas.formacion}
          </h3>
          <ul class="space-y-3 text-sm">
            {d.formacion.map((f) => (
              <li>
                <p class="font-medium text-[#1E2D24]">{f.titulo}</p>
                <p class="text-[#53645A]">{f.entidad} · {f.fechas}</p>
                {"nota" in f && f.nota && <p class="text-[#2C5E43]">{f.nota}</p>}
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-white border border-[#E2ECE5] rounded-2xl p-5 space-y-3 shadow-sm">
          <h3 class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#2C5E43]">
            <Award class="w-4 h-4" aria-hidden="true" />{d.etiquetas.premios}
          </h3>
          <ul class="space-y-2 text-sm text-[#53645A] leading-snug list-disc pl-4 marker:text-[#2C5E43]/60">
            {d.premios.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="bg-white border border-[#E2ECE5] rounded-2xl p-5 space-y-3 shadow-sm">
          <h3 class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#2C5E43]">
            <Languages class="w-4 h-4" aria-hidden="true" />{d.etiquetas.idiomas}
          </h3>
          <ul class="space-y-1.5 text-sm text-[#53645A] leading-snug">
            {d.idiomas.map((i) => <li>{i}</li>)}
            {d.otros.map((o) => <li>{o}</li>)}
          </ul>
        </div>
      </div>

      <details class="group bg-[#F4F8F5] border border-[#D5E5DA] rounded-2xl px-5 py-3">
        <summary class="flex items-center justify-between gap-4 py-2 min-h-11 cursor-pointer list-none text-sm font-medium text-[#2C5E43] [&::-webkit-details-marker]:hidden">
          {t.moreSkills}
          <ChevronDown class="w-4 h-4 transition-transform group-open:rotate-180" aria-hidden="true" />
        </summary>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3 text-sm">
          {d.competencias.map((c) => (
            <p class="text-[#53645A] font-light">
              <strong class="font-semibold text-[#284B37]">{c.grupo}:</strong> {c.items}
            </p>
          ))}
        </div>
        <h3 class="mt-5 text-xs font-semibold uppercase tracking-wider text-[#2C5E43]">{d.etiquetas.cursos}</h3>
        <ul class="mt-2 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-1.5 text-sm text-[#53645A] font-light list-disc pl-4 marker:text-[#2C5E43]/60">
          {d.cursos.map((c) => <li>{c}</li>)}
        </ul>
      </details>
    </section>

    <!-- SECCIÓN 6: CONTACTO -->
    <section id={anchor("contact")} class="reveal-entry scroll-mt-24">
      <div class="border-t border-[#E2ECE5] pt-12 grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 items-center">
        <div class="md:col-span-7 space-y-3">
          <Kicker>{t.contactKicker}</Kicker>
          <h2 class="text-2xl md:text-3xl font-bold text-[#1E2D24] tracking-tight">{t.contactTitle}</h2>
          <p class="text-[#53645A] text-sm md:text-base font-light">{t.contactText}</p>
          <a href={`mailto:${links.email}`} class="inline-block py-2 text-[#2C5E43] font-medium hover:underline underline-offset-4">
            {links.email}
          </a>
        </div>
        <div class="md:col-span-5 flex flex-col md:items-end gap-4">
          <div class="flex flex-wrap gap-3">
            <a
              href={`mailto:${links.email}`}
              class="w-12 h-12 inline-flex items-center justify-center bg-[#2C5E43] text-white hover:bg-[#1F4430] rounded-xl transition-all duration-300 hover:scale-105 shadow-md"
              aria-label="Email"
              title="Email"
            >
              <Mail class="w-5 h-5" />
            </a>
            {socials.map((s) => (
              <a
                href={s.href}
                target="_blank"
                rel="noopener noreferrer"
                class="w-12 h-12 inline-flex items-center justify-center bg-white border border-[#E2ECE5] hover:border-[#2C5E43]/40 text-[#53645A] hover:text-[#2C5E43] rounded-xl transition-all duration-300 hover:scale-105 shadow-sm"
                aria-label={s.label}
                title={s.label}
              >
                {s.label === "LinkedIn" && (
                  // Lucide no incluye logotipos de marcas, así que van como SVG propios.
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                  </svg>
                )}
                {s.label === "Instagram" && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="2" width="20" height="20" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {s.label === "Portfolio" && <ExternalLink class="w-5 h-5" />}
              </a>
            ))}
          </div>
          <a
            href={links.cvPdf[lang]}
            download
            class="inline-flex items-center gap-2 px-5 py-3 bg-white border border-[#D5E5DA] text-[#2C5E43] hover:border-[#2C5E43]/50 font-medium rounded-xl text-sm transition-colors"
          >
            <Download class="w-4 h-4" aria-hidden="true" />{t.downloadCv}
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="w-full py-8 border-t border-[#E2ECE5] text-center text-xs text-[#53645A] font-light bg-[#F3EFEB]/30 mt-auto">
    <div class="max-w-5xl mx-auto px-6">
      <p>&copy; <span data-year>{year}</span> Pablo Blázquez Gil. {t.footer}</p>
    </div>
  </footer>
</div>
